# Copy to .env.local and fill in. Never commit real keys.

# Google Gemini API key (Google AI Studio). Without it the roadmap works
# without AI advice.
GEMINI_API_KEY=

# Optional: models to try in order, comma-separated
# (default: gemini-3.5-flash-lite,gemini-3.1-flash-lite).
GEMINI_MODEL=

# Groq API key (GroqCloud), used when Gemini fails. Either key alone is enough.
GROQ_API_KEY=

# Optional: Groq models to try in order, comma-separated
# (default: openai/gpt-oss-120b,openai/gpt-oss-20b).
GROQ_MODEL=
